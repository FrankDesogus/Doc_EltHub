{
  "name": "documentale-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./src/css/main.css -o ./static/css/tailwind.css --watch",
    "build": "tailwindcss -i ./src/css/main.css -o ./static/css/tailwind.css --minify",
    "vendor:pdfjs": "mkdir -p static/vendor/pdfjs && cp node_modules/pdfjs-dist/build/pdf.min.mjs node_modules/pdfjs-dist/build/pdf.worker.min.mjs static/vendor/pdfjs/"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.0",
    "pdfjs-dist": "^6.2.108",
    "tailwindcss": "^3.4.0"
  }
}
